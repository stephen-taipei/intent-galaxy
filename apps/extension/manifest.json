{
  "manifest_version": 3,
  "name": "Intent Galaxy (Claude Code Mod & Multi-AI)",
  "version": "0.1.0",
  "description": "Injects the `iG` (Intent Galaxy) pill button into Claude, ChatGPT, Grok & Gemini input bars for 60s visual intent alignment.",
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://chatgpt.com/*",
        "https://grok.com/*",
        "https://gemini.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "panel.html",
        "panel.js",
        "galaxy/*"
      ],
      "matches": [
        "https://claude.ai/*",
        "https://chatgpt.com/*",
        "https://grok.com/*",
        "https://gemini.google.com/*"
      ]
    }
  ]
}
